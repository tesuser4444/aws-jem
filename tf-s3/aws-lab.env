# Uso: source aws-lab.env
# Quita la configuración del emulador y apunta a AWS real con el perfil "lab".
unset AWS_ENDPOINT_URL AWS_SHARED_CREDENTIALS_FILE AWS_CONFIG_FILE AWS_CA_BUNDLE \
      AWS_DISABLE_HOST_PREFIX_INJECTION AWS_EC2_METADATA_DISABLED \
      AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
export AWS_PROFILE=lab
export AWS_REGION=us-east-1
export AWS_DEFAULT_REGION=us-east-1
